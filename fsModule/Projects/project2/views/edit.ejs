<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>   
    <a href="/" class="text-blue-500 font-medium hover:text-blue-700">Back to Home</a>
    <form action="/edit" method="POST">
        <input class="border border-gray-300 d-flex rounded py-2 px-4" type="text" placeholder="Previous title" name="Previous" disabled="true" value="<%=title %>">
        <input class="border border-gray-300 d-flex rounded py-2 px-4" type="text" placeholder="New title" name="New">
        <button class="bg-yellow-500 text-white py-2 px-4 rounded" type="submit">Update Task</button>
    </form>
</body>
</html>