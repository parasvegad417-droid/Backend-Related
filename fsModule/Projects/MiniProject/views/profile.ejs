<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<script src="https://cdn.tailwindcss.com"></script>
	<title><%= user.name %> | Profile</title>
</head>
<body class="min-h-screen bg-slate-100 text-slate-900">
	<header class="border-b border-slate-200 bg-white">
		<nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-8">
			<a href="/profile" class="text-lg font-bold tracking-tight text-slate-900">mini<span class="text-indigo-600">Project</span></a>
			<a href="/logout" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-50">Log out</a>
		</nav>
	</header>

	<main class="mx-auto max-w-6xl px-5 py-8 sm:px-8 sm:py-12">
		<section class="overflow-hidden rounded-2xl bg-white shadow-xl shadow-slate-200/60">
			<div class="h-32 bg-gradient-to-r from-indigo-700 via-indigo-600 to-cyan-500 sm:h-40"></div>
			<div class="px-6 pb-8 sm:px-10">
				<div class="-mt-12 flex flex-col gap-5 sm:-mt-14 sm:flex-row sm:items-end sm:justify-between">
					<div class="flex items-end gap-4">
						<div class="flex h-24 w-24 items-center justify-center rounded-2xl border-4 border-white bg-indigo-100 text-3xl font-bold text-indigo-700 shadow-lg sm:h-28 sm:w-28">
							<% if (user.profileImage) { %>
								<img src="<%= user.profileImage %>" alt="Profile" class="h-full w-full rounded-xl object-cover">
							<% } else { %>
								<%= (user.name || user.username || 'U').charAt(0).toUpperCase() %>
							<% } %>
						</div>
						<div class="pb-1">
							<h1 class="text-2xl font-bold tracking-tight sm:text-3xl"><%= user.name || user.username %></h1>
							<p class="mt-1 text-sm text-slate-500">@<%= user.username %></p>
						</div>
					</div>
					<span class="inline-flex w-fit items-center gap-2 rounded-full bg-emerald-50 px-3 py-1.5 text-sm font-semibold text-emerald-700">
						<span class="h-2 w-2 rounded-full bg-emerald-500"></span>
						Active account
					</span>
				</div>

				<div class="mt-10 grid gap-8 lg:grid-cols-[1fr_280px]">
					<div>
						<div class="rounded-xl border border-indigo-100 bg-indigo-50/50 p-5">
							<h2 class="text-lg font-bold">Share an update</h2>
							<form action="/posts" method="POST" enctype="multipart/form-data" class="mt-4">
								<label for="content" class="sr-only">Write a post</label>
								<textarea id="content" name="content" rows="4" maxlength="500" required placeholder="What would you like to share?" class="w-full resize-y rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm outline-none placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"></textarea>
								<input type="file" name="image" accept="image/*" class="mt-3 block w-full text-sm text-slate-500">
								<button type="submit" class="mt-3 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">Publish post</button>
							</form>
						</div>

						<div class="mt-8">
							<h2 class="text-lg font-bold">Recent posts</h2>
							<% if (user.posts && user.posts.length) { %>
								<div class="mt-4 space-y-3">
									<% user.posts.slice().reverse().forEach(post => { %>
										<article class="rounded-xl border border-slate-200 p-4">
											<% if (post.image) { %>
												<img src="<%= post.image %>" alt="Post image" class="mb-4 max-h-80 w-full rounded-lg object-cover">
											<% } %>
											<p class="whitespace-pre-wrap text-sm leading-6 text-slate-700"><%= post.content %></p>
											<form action="/posts/<%= post._id %>/edit" method="POST" enctype="multipart/form-data" class="mt-3 space-y-2">
												<textarea name="content" rows="2" maxlength="500" required class="w-full resize-y rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"><%= post.content %></textarea>
												<div class="flex flex-wrap items-center gap-3">
													<input type="file" name="image" accept="image/*" class="block w-full text-xs text-slate-500 sm:w-auto">
													<button type="submit" class="text-sm font-semibold text-slate-600 hover:text-indigo-600">Save post</button>
												</div>
											</form>
											<div class="mt-3 flex items-center justify-between">
												<p class="text-xs text-slate-400"><%= new Date(post.date).toLocaleDateString() %></p>
												<form action="/posts/<%= post._id %>/like" method="POST">
													<% const hasLiked = (post.likes || []).some(like => like.toString() === user._id.toString()); %>
													<button type="submit" class="text-sm font-semibold <%= hasLiked ? 'text-indigo-700' : 'text-slate-500' %> hover:text-indigo-600">
														<%= hasLiked ? 'Unlike' : 'Like' %> (<%= (post.likes || []).length %>)
													</button>
												</form>
											</div>
										</article>
									<% }) %>
								</div>
							<% } else { %>
								<p class="mt-4 rounded-xl border border-dashed border-slate-300 p-5 text-sm text-slate-500">No posts yet. Share your first update above.</p>
							<% } %>
						</div>

						<div class="flex items-center justify-between gap-4">
							<h2 class="text-lg font-bold">Account details</h2>
							<span class="text-xs font-medium text-slate-400">Editable profile</span>
						</div>
						<form action="/profile/update" method="POST" enctype="multipart/form-data" class="mt-4 grid gap-4 sm:grid-cols-2">
							<div>
								<label for="name" class="mb-2 block text-xs font-semibold uppercase tracking-wider text-slate-400">Full name</label>
								<input id="name" name="name" value="<%= user.name || '' %>" required class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200">
							</div>
							<div>
								<label for="username" class="mb-2 block text-xs font-semibold uppercase tracking-wider text-slate-400">Username</label>
								<input id="username" name="username" value="<%= user.username || '' %>" required class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200">
							</div>
							<div>
								<label for="email" class="mb-2 block text-xs font-semibold uppercase tracking-wider text-slate-400">Email address</label>
								<input id="email" name="email" type="email" value="<%= user.email || '' %>" required class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200">
							</div>
							<div>
								<label for="age" class="mb-2 block text-xs font-semibold uppercase tracking-wider text-slate-400">Age</label>
								<input id="age" name="age" type="number" min="1" max="120" value="<%= user.age || '' %>" required class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200">
							</div>
							<div class="sm:col-span-2">
								<label for="profileImage" class="mb-2 block text-xs font-semibold uppercase tracking-wider text-slate-400">Profile image</label>
								<input id="profileImage" name="profileImage" type="file" accept="image/*" class="block w-full text-sm text-slate-500">
							</div>
							<button type="submit" class="sm:col-span-2 w-full rounded-lg bg-indigo-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">Save changes</button>
						</form>
					</div>

					<aside class="rounded-xl bg-slate-50 p-5">
						<h2 class="text-lg font-bold">Your activity</h2>
						<div class="mt-5 flex items-center justify-between border-b border-slate-200 pb-4">
							<span class="text-sm text-slate-500">Posts</span>
							<span class="text-xl font-bold text-indigo-600"><%= user.posts ? user.posts.length : 0 %></span>
						</div>
						<div class="flex items-center justify-between pt-4">
							<span class="text-sm text-slate-500">Account type</span>
							<span class="text-sm font-semibold text-slate-800">Personal</span>
						</div>
					</aside>
				</div>
			</div>
		</section>
	</main>
</body>
</html>
